{
  "name": "paged-pdf-js",
  "version": "0.1.0",
  "description": "Convert HTML into paged PDFs entirely in the browser with Paged.js.",
  "type": "module",
  "license": "MIT",
  "author": "Andreas Pazureck <andreas@pazureck.de>",
  "homepage": "https://paged-pdf-js.pazureck.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apazureck/paged-pdf-js.git"
  },
  "bugs": {
    "url": "https://github.com/apazureck/paged-pdf-js/issues"
  },
  "keywords": [
    "pdf",
    "html",
    "pagedjs",
    "paged-media",
    "browser",
    "print"
  ],
  "sideEffects": false,
  "main": "./dist/paged-pdf.cjs",
  "module": "./dist/paged-pdf.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/paged-pdf.min.js",
  "jsdelivr": "./dist/paged-pdf.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/paged-pdf.js",
      "require": "./dist/paged-pdf.cjs",
      "default": "./dist/paged-pdf.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:lib && npm run prepare:downloads && npm run build:demo",
    "build:lib": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepare:downloads": "node scripts/prepare-downloads.mjs",
    "prepare:demo": "npm run build:lib && npm run prepare:downloads",
    "demo": "npm run prepare:demo && vite --config vite.demo.config.ts --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run prepare:demo && node scripts/run-e2e.mjs",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e && npm run pack:check",
    "prepublishOnly": "npm run validate"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "jspdf": "^4.2.1",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.0"
  }
}
